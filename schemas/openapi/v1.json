{
  "components": {
    "schemas": {
      "CreateSocietyRequest": {
        "additionalProperties": false,
        "description": "Found a Society.",
        "properties": {
          "founder_fnid": {
            "description": "PH0 only. From PH1 the actor comes from the session (`docs/12`). While it is accepted, every create response carries an `unauthenticated` warning.",
            "type": "string"
          },
          "handle": {
            "description": "3–24 characters of a–z, 0–9, underscore.",
            "type": "string"
          },
          "idempotency_key": {
            "description": "Makes the command safe to retry for 24 hours (`docs/10 §10`).",
            "type": "string"
          },
          "name": {
            "description": "Display name, 1–64 characters.",
            "type": "string"
          },
          "visibility": {
            "description": "Defaults to discoverable.",
            "enum": [
              "public",
              "discoverable",
              "private",
              "sealed"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "handle"
        ],
        "type": "object"
      },
      "Error": {
        "description": "Cause, then remedy, no apology (docs/33 §7.3).",
        "properties": {
          "code": {
            "enum": [
              "usage",
              "invalid_identifier",
              "invalid_handle",
              "invalid_fnid",
              "unauthenticated",
              "capability_denied",
              "confirmation_required",
              "not_found",
              "conflict",
              "rejected",
              "rate_limited",
              "store_unavailable",
              "unreachable",
              "internal"
            ],
            "type": "string"
          },
          "detail": {
            "description": "What happened, specifically.",
            "type": "string"
          },
          "docs": {
            "format": "uri",
            "type": "string"
          },
          "remedy": {
            "description": "What to do about it.",
            "properties": {
              "human": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "retryable": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail",
          "retryable"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "description": "Liveness and version of a Node.",
        "properties": {
          "api_version": {
            "description": "API major version.",
            "type": "string"
          },
          "runtime": {
            "description": "Runtime version.",
            "type": "string"
          },
          "status": {
            "description": "Whether the Runtime considers itself healthy.",
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "runtime",
          "api_version"
        ],
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "description": "The machine-readable description of this Node's surface (`docs/31 §8`).",
        "properties": {
          "api_version": {
            "description": "API major version.",
            "type": "string"
          },
          "operations": {
            "description": "Every operation, generated from the schema. An agent plans against this rather than probing.",
            "type": "string"
          },
          "phase": {
            "description": "The phase this build implements.",
            "type": "string"
          },
          "runtime": {
            "description": "Runtime version.",
            "type": "string"
          }
        },
        "required": [
          "runtime",
          "api_version",
          "phase",
          "operations"
        ],
        "type": "object"
      },
      "Society": {
        "additionalProperties": false,
        "description": "A Society — the atomic container (P1).",
        "properties": {
          "created_at": {
            "description": "When it was founded.",
            "format": "int64",
            "type": "integer"
          },
          "founder": {
            "description": "FNID of the founding Citizen.",
            "type": "string"
          },
          "handle": {
            "description": "Globally unique, `@name`.",
            "type": "string"
          },
          "member_count": {
            "description": "Members. Never below 1 while Active.",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "Display name, 1–64 characters.",
            "type": "string"
          },
          "seq": {
            "description": "Position in THIS Society's log. Per-Society, never global (`docs/10 §4`).",
            "format": "int64",
            "type": "integer"
          },
          "society_id": {
            "description": "`soc_` + ULID.",
            "type": "string"
          },
          "status": {
            "description": "Lifecycle state (`docs/11 §4`).",
            "enum": [
              "forming",
              "active",
              "dormant",
              "fracturing",
              "dissolving",
              "archived"
            ],
            "type": "string"
          },
          "visibility": {
            "description": "Who may see and join it.",
            "enum": [
              "public",
              "discoverable",
              "private",
              "sealed"
            ],
            "type": "string"
          }
        },
        "required": [
          "society_id",
          "name",
          "handle",
          "founder",
          "visibility",
          "status",
          "member_count",
          "created_at",
          "seq"
        ],
        "type": "object"
      },
      "SocietyCreatedPayload": {
        "additionalProperties": false,
        "description": "Payload of `society.created.v1`.",
        "properties": {
          "founder": {
            "description": "FNID of the founding Citizen.",
            "type": "string"
          },
          "handle": {
            "description": "Handle as claimed.",
            "type": "string"
          },
          "name": {
            "description": "Display name as founded.",
            "type": "string"
          },
          "origin": {
            "description": "How this Society came to exist (`docs/11 §2.2` Lineage).",
            "enum": [
              "first_hearth",
              "founded",
              "crystallized",
              "fractured",
              "forked"
            ],
            "type": "string"
          },
          "society_id": {
            "description": "`soc_` + ULID.",
            "type": "string"
          },
          "status": {
            "description": "A Society is Active from its first event: it has one member, its founder.",
            "enum": [
              "active"
            ],
            "type": "string"
          },
          "visibility": {
            "description": "Visibility at founding.",
            "enum": [
              "public",
              "discoverable",
              "private",
              "sealed"
            ],
            "type": "string"
          }
        },
        "required": [
          "society_id",
          "name",
          "handle",
          "founder",
          "visibility",
          "status",
          "origin"
        ],
        "type": "object"
      },
      "SocietyEnvelope": {
        "additionalProperties": false,
        "description": "A single Society.",
        "properties": {
          "society": {
            "$ref": "#/components/schemas/Society",
            "description": "The Society."
          }
        },
        "required": [
          "society"
        ],
        "type": "object"
      },
      "SocietyList": {
        "additionalProperties": false,
        "description": "Every Society on this Node.",
        "properties": {
          "societies": {
            "description": "Ordered by creation time.",
            "items": {
              "$ref": "#/components/schemas/Society"
            },
            "type": "array"
          }
        },
        "required": [
          "societies"
        ],
        "type": "object"
      }
    }
  },
