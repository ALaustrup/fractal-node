{
  "$id": "https://schemas.fractalnode.dev/events/society.created.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A Society was founded. The first event in every Society's log.\n\nGENERATED by `cargo xtask codegen` from crates/support/schema.\nDo not edit: your change will be overwritten and CI will fail on the diff.",
  "properties": {
    "founder": {
      "description": "FNID of the founding Citizen.",
      "type": "string"
    },
    "handle": {
      "description": "Handle as claimed.",
      "type": "string"
    },
    "name": {
      "description": "Display name as founded.",
      "type": "string"
    },
    "origin": {
      "description": "How this Society came to exist (`docs/11 §2.2` Lineage).",
      "enum": [
        "first_hearth",
        "founded",
        "crystallized",
        "fractured",
        "forked"
      ],
      "type": "string"
    },
    "society_id": {
      "description": "`soc_` + ULID.",
      "type": "string"
    },
    "status": {
      "description": "A Society is Active from its first event: it has one member, its founder.",
      "enum": [
        "active"
      ],
      "type": "string"
    },
    "visibility": {
      "description": "Visibility at founding.",
      "enum": [
        "public",
        "discoverable",
        "private",
        "sealed"
      ],
      "type": "string"
    }
  },
  "required": [
    "society_id",
    "name",
    "handle",
    "founder",
    "visibility",
    "status",
    "origin"
  ],
  "title": "society.created.v1",
  "type": "object",
  "x-fractal-version": 1
}
