# build output
/target
**/target
/dist
**/dist
# ...EXCEPT the two `dist` directories that are not build output at all. These
# are the generated CONTRACT SURFACES: the Runtime serves tokens.css and
# api-client.js to the browser at runtime (crates/bin/node/src/main.rs), and
# `codegen --check`, `tokens --check` and `parity` all read them. Ignoring them
# meant a fresh clone could not serve the web GUI and three gates failed on
# every clean checkout — which is what a first CI run found.
!/packages/api-client/dist/
!/packages/api-client/dist/**
!/packages/tokens/dist/
!/packages/tokens/dist/**
node_modules/
.pnpm-store/

# generated at build time, not committed
/apps/web/.vite
*.tsbuildinfo

# local environment
.env
.env.*
!.env.example
*.local

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# agent scratch (42 §: checkpoints live in refs/wip, never as files)
/.scratch
/.rustsetup

# The desktop app writes files delivered into this conversation here.
# They are outputs, not sources.
Claude outputs/
